<UserControl x:Class="UartMonitor.MyToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Name="MyToolWindow">
    <DockPanel Background="#1c1c1c">

        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="8,8,8,4">
            <WrapPanel Margin="0,0,0,4" FontSize="11">
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Port:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="PortComboBox" Width="72" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Baud:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="BaudComboBox" Width="92" IsEditable="True" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Encoding:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="EncodingComboBox" Width="150" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Font:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="FontFamilyComboBox" Width="150" FontSize="11" SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Size:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="FontSizeComboBox" Width="52" IsEditable="True" FontSize="11" SelectionChanged="FontSizeComboBox_SelectionChanged" LostFocus="FontSizeComboBox_LostFocus"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Data bits:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="DataBitsComboBox" Width="48" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Stop bits:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="StopBitsComboBox" Width="60" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Parity:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="ParityComboBox" Width="72" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Flow control:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="FlowControlComboBox" Width="92" FontSize="11"/>
                </StackPanel>

                <CheckBox x:Name="MergeLineEndingsCheckBox" Content="Merge CR/LF" Foreground="#d6d6d6" IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>
                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" Foreground="#d6d6d6" IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>

                <Button x:Name="RefreshButton" Content="Refresh" Width="64" Margin="0,0,4,0" Click="RefreshButton_Click" FontSize="11"/>
                <Button x:Name="ConnectButton" Content="Connect" Width="68" Margin="0,0,4,0" Click="ConnectButton_Click" Background="#2f7d32" Foreground="#ffffff" FontWeight="SemiBold" BorderBrush="#4caf50" FontSize="11"/>
                <Button x:Name="DisconnectButton" Content="Disconnect" Width="78" Margin="0,0,4,0" Click="DisconnectButton_Click" FontSize="11"/>
                <Button x:Name="TestButton" Content="Test" Width="52" Margin="0,0,4,0" Click="TestButton_Click" FontSize="11"/>
                <Button x:Name="ClearButton" Content="Clear" Width="58" Click="ClearButton_Click" FontSize="11"/>
            </WrapPanel>

            <TextBlock x:Name="StatusTextBlock" Text="Disconnected" Foreground="#d6d6d6" FontSize="11"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <RichTextBox x:Name="LogBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#1c1c1c"
                     BorderThickness="0"
                     Padding="6,0,6,6"
                     FontFamily="Consolas"
                     FontSize="16"
                     IsDocumentEnabled="True"
                     SpellCheck.IsEnabled="False">
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                    </ContextMenu>
                </RichTextBox.ContextMenu>
            </RichTextBox>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#2a2a2a"/>

            <DockPanel Grid.Column="2" Background="#171717">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,6,4">
                    <TextBlock Text="Hex log" Foreground="#d6d6d6" VerticalAlignment="Center"/>
                    <Button x:Name="HexClearButton" Content="Clear" Width="60" Margin="8,0,0,0" Click="HexClearButton_Click"/>
                </StackPanel>

                <TextBox x:Name="HexLogBox"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#171717"
                         Foreground="#d0d0d0"
                         BorderThickness="0"
                         Padding="6,0,6,6"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         IsUndoEnabled="False"
                         SpellCheck.IsEnabled="False">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
