<UserControl x:Class="UartMonitor.MyToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Name="MyToolWindow">
    <DockPanel Background="#1c1c1c">

        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="8,8,8,4">
            <WrapPanel Margin="0,0,0,4">
                <Button x:Name="RefreshButton" Content="↻" Width="24" Height="24" Margin="0,0,4,0" Padding="0" Click="RefreshButton_Click" FontSize="14" FontFamily="Segoe UI Symbol" ToolTip="Refresh ports" Background="#2a2a2a" BorderBrush="#3b3b3b" BorderThickness="1" Foreground="#d6d6d6" Cursor="Hand" MinWidth="0" MinHeight="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="ConnectButton" Content="⚡" Width="24" Height="24" Margin="0,0,4,0" Click="ConnectButton_Click" Background="#2a2a2a" BorderBrush="#3b3b3b" BorderThickness="1" Foreground="#d6d6d6" FontWeight="SemiBold" FontSize="14" FontFamily="Segoe UI Symbol" ToolTip="Connect" Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="DisconnectButton" Content="⎋" Width="24" Height="24" Margin="0,0,4,0" Click="DisconnectButton_Click" Background="#2a2a2a" BorderBrush="#3b3b3b" BorderThickness="1" Foreground="#d6d6d6" FontSize="14" FontFamily="Segoe UI Symbol" ToolTip="Disconnect" Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="TestButton" Content="🔤" Width="24" Height="24" Margin="0,0,4,0" Click="TestButton_Click" Background="#2a2a2a" BorderBrush="#3b3b3b" BorderThickness="1" Foreground="#d6d6d6" FontSize="13" FontFamily="Segoe UI Emoji" ToolTip="Run test sample" Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <Button x:Name="ClearButton" Content="❌" Width="24" Height="24" Margin="0,0,8,0" Click="ClearButton_Click" Background="#2a2a2a" BorderBrush="#3b3b3b" BorderThickness="1" Foreground="#d6d6d6" FontSize="14" FontFamily="Segoe UI Symbol" ToolTip="Clear log" Padding="0" MinWidth="0" MinHeight="0" Cursor="Hand" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Port:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="PortComboBox" Width="72" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Baud:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="BaudComboBox" Width="64" IsEditable="True" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Encoding:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="EncodingComboBox" Width="150" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Font:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="FontFamilyComboBox" Width="112" FontSize="11" SelectionChanged="FontFamilyComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Size:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="FontSizeComboBox" Width="36" IsEditable="True" FontSize="11" SelectionChanged="FontSizeComboBox_SelectionChanged" LostFocus="FontSizeComboBox_LostFocus"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Tab:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="TabSizeComboBox" Width="36" FontSize="11" SelectionChanged="TabSizeComboBox_SelectionChanged"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Data bits:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="DataBitsComboBox" Width="38" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Stop bits:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="StopBitsComboBox" Width="35" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Parity:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="ParityComboBox" Width="72" FontSize="11"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,6,0" VerticalAlignment="Center">
                    <TextBlock Text="Flow control:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,3,0"/>
                    <ComboBox x:Name="FlowControlComboBox" Width="92" FontSize="11"/>
                </StackPanel>

                <CheckBox x:Name="MergeLineEndingsCheckBox" Content="Merge CR/LF" Foreground="#d6d6d6" IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>
                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" Foreground="#d6d6d6" IsChecked="True" Margin="0,0,6,0" VerticalAlignment="Center" FontSize="11"/>
                <CheckBox x:Name="PanelSyncCheckBox"
                          Content="Panel sync"
                          Foreground="#d6d6d6"
                          IsChecked="False"
                          Margin="0,0,6,0"
                          VerticalAlignment="Center"
                          FontSize="11"
                          ToolTip="Enables synchronized vertical and horizontal scrolling between the text and hex panes. This can significantly reduce UI responsiveness and increase scroll handling overhead, so it is disabled by default."/>

            </WrapPanel>

            <TextBlock x:Name="StatusTextBlock" Text="Disconnected" Foreground="#d6d6d6" FontSize="11"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <RichTextBox x:Name="LogBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     IsInactiveSelectionHighlightEnabled="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Visible"
                     Background="#1c1c1c"
                     BorderThickness="0"
                     Padding="6,0,6,6"
                     FontFamily="Consolas"
                     FontSize="16"
                     IsDocumentEnabled="True"
                     SpellCheck.IsEnabled="False"
                     SelectionChanged="LogBox_SelectionChanged"
                     GotKeyboardFocus="SelectionPane_GotKeyboardFocus"
                     PreviewMouseLeftButtonDown="SelectionPane_PreviewMouseLeftButtonDown"
                     ScrollViewer.ScrollChanged="Pane_ScrollChanged">
                <RichTextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                    </ContextMenu>
                </RichTextBox.ContextMenu>
            </RichTextBox>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#2a2a2a"/>

            <DockPanel Grid.Column="2" Background="#171717">
                <RichTextBox x:Name="HexLogBox"
                             IsReadOnly="True"
                             IsInactiveSelectionHighlightEnabled="True"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             Background="#171717"
                             BorderThickness="0"
                             Padding="6,0,6,6"
                             FontFamily="Consolas"
                             FontSize="16"
                             IsDocumentEnabled="True"
                             SpellCheck.IsEnabled="False"
                             SelectionChanged="HexLogBox_SelectionChanged"
                             GotKeyboardFocus="SelectionPane_GotKeyboardFocus"
                             PreviewMouseLeftButtonDown="SelectionPane_PreviewMouseLeftButtonDown"
                             ScrollViewer.ScrollChanged="Pane_ScrollChanged">
                    <RichTextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                        </ContextMenu>
                    </RichTextBox.ContextMenu>
                </RichTextBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
