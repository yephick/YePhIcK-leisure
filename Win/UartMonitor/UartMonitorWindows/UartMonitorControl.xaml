<UserControl x:Class="UartMonitor.MyToolWindowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:theming="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Imaging"
             xmlns:util="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
             xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
             xmlns:toolkit="clr-namespace:Community.VisualStudio.Toolkit;assembly=Community.VisualStudio.Toolkit"
             toolkit:Themes.UseVsTheme="True"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="300"
             Name="MyToolWindow">
    <DockPanel Background="#1c1c1c">

        <StackPanel DockPanel.Dock="Top" Orientation="Vertical" Margin="8,8,8,4">
            <WrapPanel Margin="0,0,0,6">
                <TextBlock Text="Port:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="PortComboBox" Width="100" Margin="0,0,8,0"/>

                <TextBlock Text="Baud:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="BaudComboBox" Width="110" IsEditable="True" Margin="0,0,8,0"/>

                <TextBlock Text="Encoding:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="EncodingComboBox" Width="220" Margin="0,0,8,0"/>

                <TextBlock Text="Font:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="FontFamilyComboBox" Width="220" Margin="0,0,8,0" SelectionChanged="FontFamilyComboBox_SelectionChanged"/>

                <TextBlock Text="Size:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="FontSizeComboBox" Width="70" IsEditable="True" Margin="0,0,8,0" SelectionChanged="FontSizeComboBox_SelectionChanged" LostFocus="FontSizeComboBox_LostFocus"/>

                <TextBlock Text="Data bits:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="DataBitsComboBox" Width="60" Margin="0,0,8,0"/>

                <TextBlock Text="Stop bits:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="StopBitsComboBox" Width="100" Margin="0,0,8,0"/>

                <TextBlock Text="Parity:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="ParityComboBox" Width="95" Margin="0,0,8,0"/>

                <TextBlock Text="Flow control:" Foreground="#d6d6d6" VerticalAlignment="Center" Margin="0,0,4,0"/>
                <ComboBox x:Name="FlowControlComboBox" Width="110" Margin="0,0,8,0"/>

                <CheckBox x:Name="MergeLineEndingsCheckBox" Content="Merge CR/LF" Foreground="#d6d6d6" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <CheckBox x:Name="AutoScrollCheckBox" Content="Auto-scroll" Foreground="#d6d6d6" IsChecked="True" Margin="0,0,8,0" VerticalAlignment="Center"/>

                <Button x:Name="RefreshButton" Content="Refresh" Width="75" Margin="0,0,6,0" Click="RefreshButton_Click"/>
                <Button x:Name="ConnectButton" Content="Connect" Width="80" Margin="0,0,6,0" Click="ConnectButton_Click" Background="#2f7d32" Foreground="#ffffff" FontWeight="SemiBold" BorderBrush="#4caf50"/>
                <Button x:Name="DisconnectButton" Content="Disconnect" Width="90" Margin="0,0,6,0" Click="DisconnectButton_Click"/>
                <Button x:Name="TestButton" Content="Test" Width="60" Margin="0,0,6,0" Click="TestButton_Click"/>
                <Button x:Name="ClearButton" Content="Clear" Width="70" Click="ClearButton_Click"/>
            </WrapPanel>

            <TextBlock x:Name="StatusTextBlock" Text="Disconnected" Foreground="#d6d6d6"/>
        </StackPanel>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="4"/>
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="LogBox"
                     Grid.Column="0"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="True"
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"
                     Background="#1c1c1c"
                     Foreground="#00ff00"
                     BorderThickness="0"
                     Padding="6,0,6,6"
                     FontFamily="Consolas"
                     FontSize="16"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="NoWrap"
                     IsUndoEnabled="False"
                     SpellCheck.IsEnabled="False">
                <TextBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                        <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                    </ContextMenu>
                </TextBox.ContextMenu>
            </TextBox>

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#2a2a2a"/>

            <DockPanel Grid.Column="2" Background="#171717">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="6,4,6,4">
                    <TextBlock Text="Hex log" Foreground="#d6d6d6" VerticalAlignment="Center"/>
                    <Button x:Name="HexClearButton" Content="Clear" Width="60" Margin="8,0,0,0" Click="HexClearButton_Click"/>
                </StackPanel>

                <TextBox x:Name="HexLogBox"
                         IsReadOnly="True"
                         IsReadOnlyCaretVisible="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         Background="#171717"
                         Foreground="#d0d0d0"
                         BorderThickness="0"
                         Padding="6,0,6,6"
                         FontFamily="Consolas"
                         FontSize="12"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         IsUndoEnabled="False"
                         SpellCheck.IsEnabled="False">
                    <TextBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="Copy" Command="ApplicationCommands.Copy"/>
                            <MenuItem Header="Select All" Command="ApplicationCommands.SelectAll"/>
                        </ContextMenu>
                    </TextBox.ContextMenu>
                </TextBox>
            </DockPanel>
        </Grid>
    </DockPanel>
</UserControl>
